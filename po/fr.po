msgstr "Privilégier Wayland lorsqu'il est disponible, sinon utiliser X11."

#: src/windows/details_window.vala:1003
msgid "Wayland and X11"
msgstr "Wayland et X11"

#: src/windows/details_window.vala:1003
msgid "Prefer Wayland, otherwise X11"
msgstr "Privilégier Wayland, sinon X11"

#: src/windows/details_window.vala:1003
msgid "Wayland only"
msgstr "Wayland seulement"

