msgid "Full session bus"
msgstr "Bus de session non-restreinte"

#: src/windows/details_window.vala:1010
msgid ""
"Unfiltered access to desktop services. Weakens the sandbox, so grant it only "
"to apps you trust."
msgstr ""
"Accès sans restriction aux services du bureau. Cela affaiblit la sandbox. "
"N'accordez donc cette autorisation qu'aux applications auxquelles vous faites "
"confiance."

#: src/windows/details_window.vala:1018 src/windows/details_window.vala:1188
