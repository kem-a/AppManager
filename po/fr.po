msgid "Network"
msgstr "Réseau"

#: src/windows/details_window.vala:992
msgid "Sound"
msgstr "Son"

#: src/windows/details_window.vala:993
msgid "Includes microphone: playback and recording share one connection."
msgstr ""
"Microphone inclus : la lecture et l'enregistrement partagent une seule "
"connexion."

#: src/windows/details_window.vala:999
msgid "Display"
msgstr "Affichage"

#: src/windows/details_window.vala:1002
